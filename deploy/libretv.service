[Unit]
Description=LibreTV personal video service
After=network.target

[Service]
Type=simple
User=libretv
Group=libretv
WorkingDirectory=/opt/libretv/current
ExecStart=/usr/bin/node server.js
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=18874
Environment=NEXT_TELEMETRY_DISABLED=1
EnvironmentFile=/etc/libretv/libretv.env
Restart=on-failure
RestartSec=5
UMask=0077
MemoryHigh=384M
MemoryMax=512M
CPUQuota=150%
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CacheDirectory=libretv

[Install]
WantedBy=multi-user.target
